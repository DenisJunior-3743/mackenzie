# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# ---- Cloudinary (media storage) ---------------------------------------
# Public: safe to ship to the browser. Nuxt maps NUXT_PUBLIC_* onto runtimeConfig.public.*
# Also set this one in Vercel -> Project Settings -> Environment Variables.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Secret: used ONLY by `npm run upload:media` on your machine (scripts/upload-media.mjs).
# Never prefix these with NUXT_PUBLIC_ and don't add them to Vercel unless a server route needs them.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Search / SEO (both optional; set them in Vercel, not locally) -----
# The Search Console token is already set in nuxt.config.ts. Only set this to override it:
# NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Only once you have a custom domain; until then the *.vercel.app address is detected automatically.
# NUXT_PUBLIC_SITE_URL=https://www.yourdomain.org
